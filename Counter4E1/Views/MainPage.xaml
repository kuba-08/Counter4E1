<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Counter4E1.Views"
             x:Class="Counter4E1.Views.MainPage">

    <Grid Padding="20" RowDefinitions="Auto,*">

        
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="15">

            <Label
                Text="Początkowy licznik"
                FontSize="24"
                HorizontalOptions="Center"/>

            <Label
                x:Name="counterLabel"
                FontSize="38"
                HorizontalOptions="Center"
                Text="0"/>

            <HorizontalStackLayout
                Spacing="20"
                HorizontalOptions="Center">

                <Button
                    Text="-"
                    Clicked="SubtractFromCounter"
                    FontSize="25"
                    WidthRequest="70"/>

                <Button
                    Text="+"
                    Clicked="AddToCounter"
                    FontSize="25"
                    WidthRequest="70"/>

            </HorizontalStackLayout>

            <BoxView
                HeightRequest="1"
                BackgroundColor="Gray"
                Margin="0,10"/>

            <Editor
                x:Name="newCounterName"
                Placeholder="Podaj nazwę licznika"
                HeightRequest="30"/>

            <Editor
                x:Name="newCounterValue"
                Placeholder="Podaj wartość początkową licznika"
                HeightRequest="30"/>

            <Button
                Text="Dodaj licznik"
                Clicked="AddNewCounter"
                Margin="0,0,0,10"/>

        </VerticalStackLayout>

        
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Counters}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <views:CounterView/>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
